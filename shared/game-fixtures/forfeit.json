              "forfeited": true,
              "eliminated": false,
              "H": 5
            },
            { "stack": 990, "folded": false }
          ]
        }
      },
      { "type": "FORFEIT", "playerId": "p1", "expectError": "INVALID_ACTION" },
      { "type": "CALL", "playerId": "p0" },
      { "type": "CHECK", "playerId": "p2" },
      { "type": "BET", "playerId": "p2", "additional": 10 },
      { "type": "FOLD", "playerId": "p0" }
    ],
    "context": { "id": "FF01", "at": "2026-10-29T00:00:00Z" },
    "expectedStateSubset": {
